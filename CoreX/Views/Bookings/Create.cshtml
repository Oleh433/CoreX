@model CoreX.Application.DTO.CreateBookingDto

<h2>Create Booking</h2>

<form method="post">
    <div class="form-group">
        <label>Club Id</label>
        <input asp-for="ClubId" class="form-control" />
    </div>

    <div class="form-group">
        <label>Subscription Id (optional)</label>
        <input asp-for="SubscriptionId" class="form-control" />
    </div>

    <div class="form-group">
        <label>Discount Id (optional)</label>
        <input asp-for="DiscountId" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">
        Create
    </button>
</form>

<a class="btn btn-secondary mt-3" href="/bookings/my">
    Cancel
</a>

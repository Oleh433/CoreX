@model CoreX.Pages.Admin.Subscriptions.IndexModel.SubscriptionRow

<tr id="row-@Model.Subscription.Id">
    <td class="px-4 py-3 font-semibold">@Model.Subscription.Title</td>
    <td class="px-4 py-3">@Model.ClubName</td>
    <td class="px-4 py-3">@Model.Subscription.Price.ToString("0.##") ₴</td>
    <td class="px-4 py-3">@Model.Subscription.DurationDays</td>
    <td class="px-4 py-3">
        @if (Model.Subscription.IsActive)
        {
            <span class="text-xs font-semibold uppercase rounded-pill px-3 py-1 bg-success/10 text-success">Активний</span>
        }
        else
        {
            <span class="text-xs font-semibold uppercase rounded-pill px-3 py-1 bg-ink-200 text-ink-500">Неактивний</span>
        }
    </td>
    <td class="px-4 py-3 text-right space-x-2">
        <a asp-page="Edit" asp-route-id="@Model.Subscription.Id" class="text-brand-500 hover:underline">Редагувати</a>
        @if (Model.Subscription.IsActive)
        {
            <button type="button"
                    hx-post="/Admin/Subscriptions?handler=Deactivate&id=@Model.Subscription.Id"
                    hx-target="#row-@Model.Subscription.Id"
                    hx-swap="outerHTML"
                    class="text-warning hover:underline">Деактивувати</button>
        }
        else
        {
            <button type="button"
                    hx-post="/Admin/Subscriptions?handler=Activate&id=@Model.Subscription.Id"
                    hx-target="#row-@Model.Subscription.Id"
                    hx-swap="outerHTML"
                    class="text-success hover:underline">Активувати</button>
        }
        <button type="button"
                hx-post="/Admin/Subscriptions?handler=Delete&id=@Model.Subscription.Id"
                hx-confirm="Видалити абонемент?"
                hx-target="#row-@Model.Subscription.Id"
                hx-swap="outerHTML swap:0.3s"
                class="text-danger hover:underline">Видалити</button>
    </td>
</tr>

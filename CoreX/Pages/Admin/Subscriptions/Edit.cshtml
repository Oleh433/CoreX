@page "/Admin/Subscriptions/{id:guid}/Edit"
@model CoreX.Pages.Admin.Subscriptions.EditModel
@{
    ViewData["Title"] = "Редагування абонемента";
}

<h1 class="text-2xl font-black uppercase tracking-tight">Редагування абонемента</h1>
@if (!string.IsNullOrEmpty(Model.ClubName))
{
    <p class="mt-1 text-sm text-ink-500">Клуб: <span class="font-semibold text-ink-800">@Model.ClubName</span></p>
}

<form method="post" class="mt-6 max-w-2xl space-y-5" novalidate>
    <div asp-validation-summary="ModelOnly" class="rounded-card border border-danger bg-danger/5 text-danger px-4 py-3 text-sm"></div>

    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Назва</label>
        <input asp-for="Input.Title" required class="mt-1 block w-full rounded-card border-ink-200 focus:border-brand-500 focus:ring-brand-500" />
        <span asp-validation-for="Input.Title" class="mt-1 block text-sm text-danger"></span></div>
    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Ціна (₴)</label>
        <input asp-for="Input.Price" type="number" step="0.01" min="0" required class="mt-1 block w-full rounded-card border-ink-200 focus:border-brand-500 focus:ring-brand-500" />
        <span asp-validation-for="Input.Price" class="mt-1 block text-sm text-danger"></span></div>
    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Тривалість (днів)</label>
        <input asp-for="Input.DurationDays" type="number" min="1" required class="mt-1 block w-full rounded-card border-ink-200 focus:border-brand-500 focus:ring-brand-500" />
        <span asp-validation-for="Input.DurationDays" class="mt-1 block text-sm text-danger"></span></div>
    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Ліміт відвідувань (необов'язково)</label>
        <input asp-for="Input.VisitsLimit" type="number" min="1" class="mt-1 block w-full rounded-card border-ink-200" />
        <span asp-validation-for="Input.VisitsLimit" class="mt-1 block text-sm text-danger"></span></div>
    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Опис (необов'язково)</label>
        <textarea asp-for="Input.Description" rows="4" class="mt-1 block w-full rounded-card border-ink-200 focus:border-brand-500 focus:ring-brand-500"></textarea>
        <span asp-validation-for="Input.Description" class="mt-1 block text-sm text-danger"></span></div>

    <div class="flex gap-3">
        <button type="submit" class="btn-brand">Зберегти</button>
        <a asp-page="Index" class="btn-ghost">Скасувати</a>
    </div>
</form>

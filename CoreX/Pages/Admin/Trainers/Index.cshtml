@page
@model CoreX.Pages.Admin.Trainers.IndexModel
@{
    ViewData["Title"] = "Тренери";
}

<div class="flex items-center justify-between">
    <h1 class="text-2xl font-black uppercase tracking-tight">Тренери</h1>
    <a asp-page="Create" class="btn-brand">+ Новий тренер</a>
</div>

@if (Model.Trainers.Count == 0)
{
    <p class="mt-6 text-ink-500">Поки немає тренерів.</p>
}
else
{
    <table class="mt-6 w-full bg-white rounded-card border border-ink-200 text-sm">
        <thead class="bg-ink-50 text-left text-xs uppercase tracking-wider text-ink-500">
            <tr>
                <th class="px-4 py-2">Повне ім'я</th>
                <th class="px-4 py-2">Спеціалізація</th>
                <th class="px-4 py-2">Клуб</th>
                <th class="px-4 py-2">Досвід (років)</th>
                <th class="px-4 py-2 text-right">Дії</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-ink-200">
        @foreach (var t in Model.Trainers)
        {
            <tr id="row-@t.Id">
                <td class="px-4 py-3 font-semibold">@t.FullName</td>
                <td class="px-4 py-3">@t.Specialization</td>
                <td class="px-4 py-3 text-ink-500">@t.ClubName</td>
                <td class="px-4 py-3">@t.ExperienceYears</td>
                <td class="px-4 py-3 text-right">
                    <button type="button"
                            hx-post="/Admin/Trainers?handler=Delete&id=@t.Id"
                            hx-confirm="Видалити тренера @t.FullName?"
                            hx-target="#row-@t.Id"
                            hx-swap="outerHTML swap:0.3s"
                            class="text-danger hover:underline">Видалити</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

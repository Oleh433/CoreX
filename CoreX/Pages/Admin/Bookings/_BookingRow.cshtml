@model CoreX.Application.DTO.BookingResponseDto

<tr id="booking-row-@Model.Id">
    <td class="px-4 py-3 font-semibold">@Model.ContactFullName</td>
    <td class="px-4 py-3 text-sm text-ink-500">@Model.ContactEmail</td>
    <td class="px-4 py-3 text-sm text-ink-500">@Model.ContactPhone</td>
    <td class="px-4 py-3">
        @{
            var (badgeClass, badgeText) = Model.Status switch
            {
                "New" => ("bg-brand-50 text-brand-700", "Нове"),
                "Confirmed" => ("bg-success/10 text-success", "Підтверджено"),
                "Cancelled" => ("bg-ink-200 text-ink-500", "Скасовано"),
                "Completed" => ("bg-info/10 text-info", "Завершено"),
                _ => ("bg-ink-200 text-ink-500", Model.Status),
            };
        }
        <span class="text-xs font-semibold uppercase rounded-pill px-3 py-1 @badgeClass">@badgeText</span>
    </td>
    <td class="px-4 py-3 text-sm text-ink-500">@Model.CreatedAt.ToString("yyyy-MM-dd")</td>
    <td class="px-4 py-3 text-right space-x-2">
        @if (Model.Status == "New")
        {
            <button type="button"
                    hx-post="/Admin/Bookings?handler=Confirm&id=@Model.Id"
                    hx-target="#booking-row-@Model.Id"
                    hx-swap="outerHTML"
                    class="text-success hover:underline">Підтвердити</button>
        }
        @if (Model.Status == "New" || Model.Status == "Confirmed")
        {
            <button type="button"
                    hx-post="/Admin/Bookings?handler=Cancel&id=@Model.Id"
                    hx-confirm="Скасувати бронювання?"
                    hx-target="#booking-row-@Model.Id"
                    hx-swap="outerHTML"
                    class="text-danger hover:underline">Скасувати</button>
        }
    </td>
</tr>

@page
@model CoreX.Pages.Admin.VacancyApplications.IndexModel
@{
    ViewData["Title"] = "Заявки";
}

<h1 class="text-2xl font-black uppercase tracking-tight">Заявки</h1>

@if (Model.Applications.Count == 0)
{
    <p class="mt-6 text-ink-500">Поки немає заявок.</p>
}
else
{
    <table class="mt-6 w-full bg-white rounded-card border border-ink-200 text-sm">
        <thead class="bg-ink-50 text-left text-xs uppercase tracking-wider text-ink-500">
            <tr>
                <th class="px-4 py-2">Імʼя</th>
                <th class="px-4 py-2">Email</th>
                <th class="px-4 py-2">Телефон</th>
                <th class="px-4 py-2">Вакансія</th>
                <th class="px-4 py-2">Статус</th>
                <th class="px-4 py-2 text-right">Дії</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-ink-200">
        @foreach (var a in Model.Applications)
        {
            @await Html.PartialAsync("_ApplicationRow", a)
        }
        </tbody>
    </table>
}

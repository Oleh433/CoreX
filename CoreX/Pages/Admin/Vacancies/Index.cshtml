@page
@model CoreX.Pages.Admin.Vacancies.IndexModel
@{
    ViewData["Title"] = "Вакансії";
}

<div class="flex items-center justify-between">
    <h1 class="text-2xl font-black uppercase tracking-tight">Вакансії</h1>
    <a asp-page="Create" class="btn-brand">+ Нова вакансія</a>
</div>

@if (Model.Vacancies.Count == 0)
{
    <p class="mt-6 text-ink-500">Поки немає вакансій.</p>
}
else
{
    <table class="mt-6 w-full bg-white rounded-card border border-ink-200 text-sm">
        <thead class="bg-ink-50 text-left text-xs uppercase tracking-wider text-ink-500">
            <tr>
                <th class="px-4 py-2">Заголовок</th>
                <th class="px-4 py-2">Клуб</th>
                <th class="px-4 py-2">Статус</th>
                <th class="px-4 py-2 text-right">Дії</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-ink-200">
        @foreach (var v in Model.Vacancies)
        {
            @await Html.PartialAsync("_VacancyRow", v)
        }
        </tbody>
    </table>
}

@page
@model CoreX.Pages.Admin.Vacancies.CreateModel
@{
    ViewData["Title"] = "Нова вакансія";
}

<h1 class="text-2xl font-black uppercase tracking-tight">Нова вакансія</h1>

<form method="post" class="mt-6 max-w-2xl space-y-5" novalidate>
    <div asp-validation-summary="ModelOnly" class="rounded-card border border-danger bg-danger/5 text-danger px-4 py-3 text-sm"></div>

    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Клуб</label>
        <select asp-for="Input.ClubId" asp-items="Model.ClubOptions" required class="mt-1 block w-full rounded-card border-ink-200 focus:border-brand-500 focus:ring-brand-500">
            <option value="">— Оберіть клуб —</option>
        </select>
        <span asp-validation-for="Input.ClubId" class="mt-1 block text-sm text-danger"></span></div>
    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Заголовок</label>
        <input asp-for="Input.Title" required class="mt-1 block w-full rounded-card border-ink-200 focus:border-brand-500 focus:ring-brand-500" />
        <span asp-validation-for="Input.Title" class="mt-1 block text-sm text-danger"></span></div>
    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Опис</label>
        <textarea asp-for="Input.Description" rows="5" required class="mt-1 block w-full rounded-card border-ink-200 focus:border-brand-500 focus:ring-brand-500"></textarea>
        <span asp-validation-for="Input.Description" class="mt-1 block text-sm text-danger"></span></div>
    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Вимоги</label>
        <textarea asp-for="Input.Requirements" rows="4" required class="mt-1 block w-full rounded-card border-ink-200 focus:border-brand-500 focus:ring-brand-500"></textarea>
        <span asp-validation-for="Input.Requirements" class="mt-1 block text-sm text-danger"></span></div>
    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Зарплата (необов'язково)</label>
        <input asp-for="Input.Salary" type="number" step="0.01" min="0" class="mt-1 block w-full rounded-card border-ink-200" />
        <span asp-validation-for="Input.Salary" class="mt-1 block text-sm text-danger"></span></div>
    <div><label class="block text-xs font-semibold uppercase tracking-wide text-ink-800">Дедлайн заявок (необов'язково)</label>
        <input asp-for="Input.ApplicationDeadline" type="datetime-local" class="mt-1 block w-full rounded-card border-ink-200" />
        <span asp-validation-for="Input.ApplicationDeadline" class="mt-1 block text-sm text-danger"></span></div>

    <div class="flex gap-3">
        <button type="submit" class="btn-brand">Створити</button>
        <a asp-page="Index" class="btn-ghost">Скасувати</a>
    </div>
</form>

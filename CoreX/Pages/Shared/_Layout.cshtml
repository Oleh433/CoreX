@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="@(ViewData["Description"] ?? "CoreX — мережа фітнес-клубів. Знайди клуб поруч, обери абонемент і починай тренування вже сьогодні.")" />
    <title>@(ViewData["Title"]) · CoreX</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body hx-headers='{"@tokens.HeaderName":"@tokens.RequestToken"}'>

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-brand-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-card">
        Перейти до контенту
    </a>

    <header role="banner" class="border-b border-ink-200 bg-white">
        <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-6">
            <a href="/" class="text-2xl font-black tracking-tight text-ink-900">
                Core<span class="text-brand-500">X</span>
            </a>
            <nav role="navigation" aria-label="Головна навігація" class="hidden md:flex items-center gap-6 text-sm font-semibold text-ink-800">
                <a href="/Clubs">Клуби</a>
                <a href="/Memberships">Абонементи</a>
                <a href="/Trainers">Тренери</a>
                <a href="/Discounts">Акції</a>
                <a href="/Vacancies">Вакансії</a>
            </nav>
            <div class="flex items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin") || User.IsInRole("Owner"))
                    {
                        <a href="/Admin" class="btn-ghost text-sm">Адмін-панель</a>
                    }
                    <a href="/Account/Profile" class="btn-ghost text-sm">Профіль</a>
                    <a href="/Account/MyBookings" class="btn-ghost text-sm">Мої бронювання</a>
                    <form method="post" action="/Account/Logout" class="inline">
                        <input type="hidden" name="__RequestVerificationToken" value="@tokens.RequestToken" />
                        <button type="submit" class="btn-ghost text-sm">Вийти</button>
                    </form>
                }
                else
                {
                    <a href="/Account/Login" class="btn-ghost text-sm">Увійти</a>
                    <a href="/Account/Register" class="btn-brand text-sm">Реєстрація</a>
                }
            </div>
        </div>
    </header>

    <main id="main-content" role="main">
        @RenderBody()
    </main>

    <footer role="contentinfo" class="border-t border-ink-200 bg-ink-50 mt-16">
        <div class="max-w-6xl mx-auto px-4 py-8 text-sm text-ink-500">
            © @DateTime.UtcNow.Year CoreX. Усі права захищено.
        </div>
    </footer>

    <script src="~/js/htmx.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
